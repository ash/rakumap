use lib $?FILE.IO.parent.parent.add('lib').Str;
use Test;
use RakuMap::Generator::Unicode;
use RakuMap::Generator::Registry;

plan 8;

my %first = generate-unicode(40);
my %again = generate-case('unicode', 40);
is %first<source>, %again<source>, 'registry preserves deterministic source';
is-deeply %first<witness>, %again<witness>, 'registry preserves generation witness';
is %first<witness><generator>, 'unicode-v1', 'domain version is recorded';
is %first<witness><confidence>, 'C', 'restricted generator reports confidence C';
ok %first<source>.contains('say "TYPE\t"'), 'observation envelope uses a real tab escape';

my %templates;
for 0 .. 119 -> $seed {
    my %case = generate-unicode($seed);
    %templates{%case<witness><template>} = True;
    my $source = $*TMPDIR.add("rakumap-unicode-$*PID-$seed.raku");
    $source.spurt(%case<source>);
    my $compile = run $*EXECUTABLE, '-c', $source.Str, :out, :err;
    die "seed $seed did not compile" if $compile.exitcode;
    $source.unlink;
}
is %templates.elems, 12, 'seed sweep reaches every Unicode template';
lives-ok { generate-case('unicode', 999) }, 'arbitrary seed generates successfully';
dies-ok { selected-generators('Unicode') }, 'generator names remain exact and lowercase';
