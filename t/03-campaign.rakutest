use lib $?FILE.IO.parent.parent.add('lib').Str;
use Test;
use Rakumap::Campaign;

plan 19;

my $root = $?FILE.IO.parent.parent;
my $out = $*TMPDIR.add("rakumap-campaign-$*PID");
my $oracle = $root.add('fixtures/engines/echo-a.sh').absolute.Str;
my $candidate = $root.add('fixtures/engines/echo-b.sh').absolute.Str;

my %summary = explore(
    :seed(70), :cases(2), :repetitions(2), :timeout(2),
    :$oracle, :$candidate, :$out,
);

is %summary<cases>, 2, 'requested seeds were explored';
is %summary<divergent>, 2, 'planted output differences are detected';
is %summary<stable>, 2, 'repeated planted differences are stable';

my $finding = $out.add('findings/numeric-00000070');
ok $finding.add('case.raku').f, 'reproducer is persisted';
ok $finding.add('original.raku').f, 'original source is persisted';
ok $finding.add('finding.json').f, 'machine-readable metadata is persisted';
ok $finding.add('finding.json').slurp.contains('"stability": "stable"'),
    'metadata records stability';
ok $out.add('campaign.json').slurp.contains('"oracle-identity"'),
    'canonical campaign records engine identity';
is $out.add('results').dir(test => / '.tsv' $/).elems, 2,
    'one durable completion record is written per seed';
ok $out.add('clusters.tsv').slurp.starts-with("cluster\tcount\trepresentative-seed"),
    'deterministic cluster summary is written';
is $out.add('findings').dir.elems, 1,
    'duplicate signatures share one representative dossier';
ok $out.add('clusters.tsv').slurp.lines.grep(*.contains("\t2\t70")).elems == 1,
    'cluster preserves duplicate count and representative seed';
ok $finding.add('finding.json').slurp.contains('"cluster-key"'),
    'finding records its cluster key';
ok $finding.add('shrink.json').f, 'stable finding is minimized automatically';
ok $finding.add('original.raku').s >= $finding.add('case.raku').s,
    'automatic minimization retains the original and a no-larger reproducer';
my %resumed = explore(
    :seed(70), :cases(2), :repetitions(2), :timeout(2), :resume,
    :$oracle, :$candidate, :$out,
);
is %resumed<cases>, 2, 'resumed campaign retains its requested case count';
is %resumed<divergent>, 2, 'resume restores completed result counts';
dies-ok { replay($finding, :oracle($candidate), :$candidate, :timeout(2)) },
    'replay rejects an engine identity mismatch';
ok replay($finding, :$oracle, :$candidate, :timeout(2)), 'persisted finding reproduces';
