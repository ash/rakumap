use lib $?FILE.IO.parent.parent.add('lib').Str;
use Test;
use RakuMap::Export;
plan 9;
my $dossier = $*TMPDIR.add("rakumap-export-$*PID"); $dossier.mkdir;
$dossier.add('case.raku').spurt("say 42;\n");
$dossier.add('oracle.stdout').spurt("42\n");
is classify-dossier($dossier, 'candidate-defect').slurp.trim, 'candidate-defect', 'classification is persisted';
dies-ok { classify-dossier($dossier, 'certainly-a-bug') }, 'classification vocabulary is closed';
my $regression = $dossier.add('regression.raku');
is export-dossier($dossier, :format<rakupp>, :out($regression)), $regression, 'Raku++ export returns destination';
ok $regression.slurp.contains('say "PASS"'), 'Raku++ regression ends with PASS output';
my $grid = $dossier.add('rakugrid.json'); export-dossier($dossier, :format<rakugrid>, :out($grid));
ok $grid.slurp.contains('"kind": "rakumap-finding"'), 'Rakugrid interchange identifies its kind';
ok $grid.slurp.contains('"classification": "candidate-defect"'), 'Rakugrid export carries classification';
my $report = $dossier.add('report.md'); export-dossier($dossier, :format<standalone>, :out($report));
ok $report.slurp.contains('```raku'), 'standalone export embeds reproducer';
ok $report.slurp.contains('candidate-defect'), 'standalone export carries classification';
dies-ok { export-dossier($dossier, :format<unknown>, :out($report)) }, 'unknown export formats fail visibly';
