use lib $?FILE.IO.parent.parent.add('lib').Str;
use Test;
use RakuMap::Campaign;
use RakuMap::Shrink;

plan 7;
my $root = $?FILE.IO.parent.parent;
my $out = $*TMPDIR.add("rakumap-shrink-$*PID");
my $oracle = $root.add('fixtures/engines/echo-a.sh').absolute.Str;
my $candidate = $root.add('fixtures/engines/echo-b.sh').absolute.Str;
explore(:seed(70), :cases(1), :repetitions(2), :timeout(2), :$oracle, :$candidate, :$out);
my $finding = $out.add('findings/numeric-00000070');
my $before = $finding.add('case.raku').s;
my %result = shrink-dossier($finding, :$oracle, :$candidate,
    :timeout(2), :repetitions(2), :budget(100));
ok %result<calls> > 0, 'shrinker attempts deterministic reductions';
ok %result<minimum-bytes> < $before, 'accepted reduction makes the case smaller';
is $finding.add('case.raku').s, %result<minimum-bytes>, 'minimum replaces current reproducer';
is $finding.add('original.raku').s, $before, 'original source remains unchanged';
ok $finding.add('shrink.json').f, 'shrink budget and result are recorded';
ok $finding.add('oracle.signature').f && $finding.add('candidate.signature').f,
    'target signature pair remains available';
ok replay($finding, :$oracle, :$candidate, :timeout(2)),
    'minimized case preserves the planted divergence';
