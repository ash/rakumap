#!/usr/bin/env rakupp

use lib $?FILE.IO.parent.parent.add('lib').Str;
use Rakumap;
use Rakumap::Campaign;
use Rakumap::Shrink;
use Rakumap::Export;

sub usage() {
    say qq:to/USAGE/;
    Rakumap {VERSION} — autonomous differential exploration for Raku

    Usage:
      rakumap generate [--generator=NAME|all] [--seed=N] [--cases=N] [--out=DIR]
      rakumap explore  [--oracle=PATH] [--candidate=PATH]
                       [--generator=NAME|all]
                       [--seed=N] [--cases=N] [--timeout=N] [--repeat=N]
                       [--max-output=N] [--resume] [--out=DIR]
                       [--shrink-budget=N] [--no-shrink]
      rakumap replay DOSSIER [--oracle=PATH] [--candidate=PATH] [--timeout=N]
                       [--relax-identity]
      rakumap shrink DOSSIER [--oracle=PATH] [--candidate=PATH]
                     [--timeout=N] [--repeat=N] [--budget=N]
      rakumap classify DOSSIER --as=CLASSIFICATION
      rakumap export DOSSIER --format=standalone|rakupp|rakugrid --out=FILE
      rakumap version
    USAGE
}

sub options(@args --> Hash:D) {
    my %o; my @positionals;
    for @args -> $arg {
        if $arg.starts-with('--') && $arg.contains('=') {
            my ($key, $value) = $arg.substr(2).split('=', 2); %o{$key} = $value;
        } elsif $arg.starts-with('--') {
            %o{$arg.substr(2)} = True;
        } else { @positionals.push($arg) }
    }
    %o<positionals> = @positionals; %o
}

sub int-option(%o, Str:D $name, Int:D $default --> Int:D) {
    return $default unless %o{$name}:exists;
    my $value = try +%o{$name};
    die "--$name needs an integer" unless $value.defined;
    $value.Int
}

sub MAIN(*@args) {
    my $command = @args.shift // 'help'; my %o = options(@args);
    given $command {
        when 'help' | '--help' | '-h' { usage }
        when 'version' | '--version' | '-V' { say VERSION }
        when 'generate' {
            my $out = (%o<out> // 'out/generated').IO;
            my $generator = %o<generator> // 'numeric';
            my $n = generate-cases(:$generator, :seed(int-option(%o, 'seed', 1)),
                :cases(int-option(%o, 'cases', 10)), :$out);
            say "generated $n programs ($generator) in {$out.Str}";
        }
        when 'explore' {
            my $out = (%o<out> // 'out/latest').IO;
            my %s = explore(:generator(%o<generator> // 'numeric'),
                :oracle(%o<oracle> // 'raku'),
                :candidate(%o<candidate> // 'rakupp'),
                :seed(int-option(%o, 'seed', 1)),
                :cases(int-option(%o, 'cases', 100)),
                :timeout(int-option(%o, 'timeout', 5)),
                :repetitions(int-option(%o, 'repeat', 2)),
                :max-output(int-option(%o, 'max-output', 65536)),
                :resume(so %o<resume>), :shrink(!so %o<no-shrink>),
                :shrink-budget(int-option(%o, 'shrink-budget', 200)), :$out);
            say "done: {%s<cases>} cases, {%s<divergent>} divergences, "
              ~ "{%s<stable>} stable, {%s<oracle-invalid>} oracle-invalid";
        }
        when 'replay' {
            my $path = %o<positionals>[0] // die 'usage: rakumap replay DOSSIER';
            my $ok = replay($path.IO, :oracle(%o<oracle> // 'raku'),
                :candidate(%o<candidate> // 'rakupp'),
                :timeout(int-option(%o, 'timeout', 5)),
                :relax-identity(so %o<relax-identity>));
            exit($ok ?? 0 !! 1);
        }
        when 'shrink' {
            my $path = %o<positionals>[0] // die 'usage: rakumap shrink DOSSIER';
            my %result = shrink-dossier($path.IO,
                :oracle(%o<oracle> // 'raku'), :candidate(%o<candidate> // 'rakupp'),
                :timeout(int-option(%o, 'timeout', 5)),
                :repetitions(int-option(%o, 'repeat', 2)),
                :budget(int-option(%o, 'budget', 200)));
            say "shrunk {%result<original-bytes>} -> {%result<minimum-bytes>} bytes "
              ~ "in {%result<calls>} calls";
        }
        when 'classify' {
            my $path = %o<positionals>[0] // die 'usage: rakumap classify DOSSIER --as=CLASSIFICATION';
            my $classification = %o<as> // die '--as is required';
            say classify-dossier($path.IO, $classification).Str;
        }
        when 'export' {
            my $path = %o<positionals>[0] // die 'usage: rakumap export DOSSIER --format=FORMAT --out=FILE';
            my $format = %o<format> // die '--format is required';
            my $destination = %o<out> // die '--out is required';
            say export-dossier($path.IO, :$format, :out($destination.IO)).Str;
        }
        default { note "unknown command '$command'"; usage; exit 2 }
    }
}
